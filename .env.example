# Local dev needs nothing: `npm run dev` starts a PGlite Postgres in ./data/pg.
# On Vercel set these in Project → Settings → Environment Variables.

# Neon Postgres (Vercel → Storage → Neon adds this automatically). Use the *pooled* URL.
DATABASE_URL=
# Long random string (openssl rand -hex 48). Required in production.
JWT_SECRET=
# Opens /admin (ad review, revenue). Required in production.
ADMIN_KEY=
# Vercel Cron secret for /api/cron/housekeeping (Vercel sends it automatically once set).
CRON_SECRET=

# ---- Real payments via nTZS mobile money. Empty = demo payments in dev, payments OFF in production.
# Start with an ntzs_test_ key, then ntzs_live_.
NTZS_API_KEY=
# Webhook secret from the nTZS dashboard; webhook URL: https://<your-domain>/api/webhooks/ntzs
NTZS_WEBHOOK_SECRET=
# NTZS_BASE_URL=https://www.ntzs.co.tz
# ALLOW_DEMO_PAYMENTS=false
